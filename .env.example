# ============================================================
# AI Tax Agent — Environment Configuration
# ============================================================
# Copy this file to .env and fill in values.
# NEVER commit .env to Git.
# Leave sensitive values empty here.
# ============================================================

# Application
APP_ENV=
LOG_LEVEL=

# Database (PostgreSQL)
DATABASE_URL=

# Vector Database (Qdrant)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=

# AWS
AWS_REGION=

# S3
S3_BUCKET_NAME=

# LLM
LLM_PROVIDER=
BEDROCK_MODEL_ID=
LLM_API_KEY=

# Agent limits
MAX_AGENT_ITERATIONS=
MAX_TOOL_CALLS=
MAX_LLM_CALLS=

# Rate limiting
DAILY_REQUEST_LIMIT=
