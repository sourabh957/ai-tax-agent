# Dev environment Terraform variables
# Copy this file to dev.tfvars and fill in values.
# NEVER commit dev.tfvars - it is in .gitignore.

aws_region  = "ap-south-1"
environment = "dev"
project     = "ai-tax-agent"

# Database credentials - leave empty here, set in dev.tfvars only
db_name     = "tax_agent"
db_username = ""
db_password = ""

# SSH key pair for the EC2 instance. Leave empty only if you rely on SSM or add it later.
key_name = ""

# Public domain for Nginx / TLS termination. Example: app.example.com
domain_name = ""

# Restrict this to your office/home/public IP in real environments.
ssh_allowed_cidr = "0.0.0.0/0"

# Cost target guidance:
# - t4g.small Spot: usually the cheapest always-on compute option for this stack
# - db.t4g.micro RDS + storage + CloudWatch + S3 generally keeps total monthly
#   cost near the ₹3,000-₹5,500 target when usage is moderate
instance_type = "t4g.small"

# Optional: set to receive CloudWatch alarm email notifications
alarm_email = ""
